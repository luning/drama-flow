{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dramaflow.dev/design-system/tokens.schema.json",
  "title": "DramaFlow Design Tokens Schema",
  "description": "JSON Schema for validating design tokens. Used by check_tokens.py to verify tokens.css and tokens.ts are in sync, and by figma_sync_tokens.py to validate Figma exports.",
  "type": "object",
  "required": ["color", "background", "border", "text", "spacing", "radius", "shadow", "transition", "typography"],
  "properties": {
    "color": {
      "type": "object",
      "required": ["primary", "primaryLight", "accent", "rating", "success", "danger", "info"],
      "properties": {
        "primary":      { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "primaryLight": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accent":       { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "primary90":    { "type": "string", "pattern": "^rgba\\(" },
        "primary85":    { "type": "string", "pattern": "^rgba\\(" },
        "primary80":    { "type": "string", "pattern": "^rgba\\(" },
        "primaryTint":  { "type": "string", "pattern": "^rgba\\(" },
        "primaryTintMd":{ "type": "string", "pattern": "^rgba\\(" },
        "rating":       { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "success":      { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "danger":       { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "info":         { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "background": {
      "type": "object",
      "required": ["primary", "card"],
      "properties": {
        "outer":          { "type": "string" },
        "primary":        { "type": "string" },
        "card":           { "type": "string" },
        "hover":          { "type": "string" },
        "elevated":       { "type": "string" },
        "skeleton":       { "type": "string" },
        "skeletonShine":  { "type": "string" },
        "deep":           { "type": "string" },
        "cardDeep":       { "type": "string" },
        "video":          { "type": "string" }
      }
    },
    "border": {
      "type": "object",
      "required": ["subtle", "default"],
      "properties": {
        "surfaceSubtle": { "type": "string" },
        "subtle":        { "type": "string" },
        "default":       { "type": "string" },
        "surfaceMid":    { "type": "string" },
        "surfaceHover":  { "type": "string" }
      }
    },
    "text": {
      "type": "object",
      "required": ["primary", "secondary", "tertiary", "muted"],
      "properties": {
        "primary":   { "type": "string" },
        "secondary": { "type": "string" },
        "label":     { "type": "string" },
        "tertiary":  { "type": "string" },
        "caption":   { "type": "string" },
        "muted":     { "type": "string" },
        "link":      { "type": "string" }
      }
    },
    "spacing": {
      "type": "object",
      "properties": {
        "xs":  { "type": "string" },
        "sm":  { "type": "string" },
        "md": { "type": "string" },
        "lg": { "type": "string" },
        "xl": { "type": "string" },
        "2xl": { "type": "string" },
        "3xl": { "type": "string" }
      }
    },
    "radius": {
      "type": "object",
      "properties": {
        "xs":   { "type": "string" },
        "sm":   { "type": "string" },
        "md":   { "type": "string" },
        "btn": { "type": "string" },
        "card":{ "type": "string" },
        "xl":  { "type": "string" },
        "2xl": { "type": "string" },
        "full": { "type": "string" }
      }
    },
    "shadow": {
      "type": "object",
      "properties": {
        "sm":   { "type": "string" },
        "md":   { "type": "string" },
        "lg":   { "type": "string" },
        "glow": { "type": "string" }
      }
    },
    "transition": {
      "type": "object",
      "properties": {
        "fast":    { "type": "string" },
        "default": { "type": "string" },
        "page":    { "type": "string" },
        "banner":  { "type": "string" }
      }
    },
    "typography": {
      "type": "object",
      "required": ["family", "size", "weight"],
      "properties": {
        "family": { "type": "string" },
        "size": {
          "type": "object",
          "properties": {
            "xs":   { "type": "string" },
            "sm":   { "type": "string" },
            "base": { "type": "string" },
            "md":   { "type": "string" },
            "lg":   { "type": "string" },
            "xl":   { "type": "string" },
            "2xl":  { "type": "string" },
            "3xl":  { "type": "string" }
          }
        },
        "weight": {
          "type": "object",
          "properties": {
            "normal":    { "type": "number" },
            "medium":    { "type": "number" },
            "semibold":  { "type": "number" },
            "bold":      { "type": "number" },
            "extrabold": { "type": "number" }
          }
        }
      }
    }
  }
}
